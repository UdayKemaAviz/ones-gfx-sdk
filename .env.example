# ONES API Configuration
BASE_URL=https://your_vm_ip:8089
REFRESH_URL=https://your_vm_ip:8089/refresh

# JWT Tokens
ACCESS_TOKEN=your_access_token_here
REFRESH_TOKEN=your_refresh_token_here

# Login Credentials
LOGIN_USERNAME=your_username
LOGIN_PASSWORD=your_password

# Fabric Configuration
FABRIC_NAME=your_fabric_name

# Webhook Configuration (for async-webhook mode)
WEBHOOK_URL=http://your_webhook_endpoint:5000/test/webhook-receiver

# TLS Verification (set to false only for dev/lab with self-signed certs)
VERIFY_TLS=false

# Default timeout in seconds for sync operations
DEFAULT_TIMEOUT_S=1200
